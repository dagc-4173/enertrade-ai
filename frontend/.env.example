# Copiar a .env.local y ajustar a la URL pública del backend del entorno.
# Esta variable es pública en el bundle: no incluir secretos ni credenciales.
# URL base sin consulta ni fragmento. Reiniciar Vite después de cambiarla.
VITE_API_BASE_URL=http://localhost:3000
# No existe fallback a localhost: definirla para cada build desplegable.
# La conexión entre orígenes requiere FRONTEND_ORIGIN en el servidor.
