# Copiar a .env.local y ajustar al backend Express del entorno.
# Esta variable es pública en el bundle: no incluir secretos ni credenciales.
# URL base sin consulta ni fragmento. Reiniciar Vite después de cambiarla.
VITE_API_BASE_URL=http://localhost:3000
# La conexión entre orígenes requiere CORS en el servidor o un proxy externo.
