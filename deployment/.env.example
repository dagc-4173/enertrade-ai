# Copiar a .env.deploy en la raíz. NO registrar valores reales en Git.
# Compose: docker compose --env-file .env.deploy ...
NODE_ENV=production
PUBLIC_ORIGIN=https://REEMPLAZAR-POR-URL-PUBLICA.example
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=verify-full
LOCAL_PORT=8080
# 0 para acceso local directo; configurar 1 solo tras revisar el proxy de confianza.
TRUST_PROXY_HOPS=0
BUILD_TARGET=runtime-chronos
CHRONOS_REQUIRED=true
# Rutas del host con los snapshots exactos. En Windows usar C:/ruta/...
CHRONOS2_HOST_PATH=./deployment/models/chronos2
CHRONOS_BOLT_HOST_PATH=./deployment/models/bolt
# Desactivado para primer arranque; habilitar tras comprobar XM y restaurar datos.
XM_AUTO_SYNC_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
