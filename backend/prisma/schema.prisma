// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnergyDatasetType {
  generacion
  consumo
  oferta
  demanda
  precios
  transacciones_simuladas
}

enum EnergyDatasetStatus {
  recibido
  aprobado
  advertencia
  rechazado
}

enum XmIngestionWindowStatus {
  pending
  completed
  failed
}

model EnergyDataset {
  id                    Int                 @id @default(autoincrement())
  source                String
  dataType              EnergyDatasetType
  uploadedAt            DateTime            @default(now()) @db.Timestamptz(3)
  status                EnergyDatasetStatus @default(recibido)
  content               Json
  pendingOptionalFields Json
  validatedAt           DateTime?           @db.Timestamptz(3)
  validationReport      Json?
  preparedDatasets      PreparedDataset[]
  xmIngestionWindow     XmIngestionWindow?
}

model XmIngestionWindow {
  id           Int                     @id @default(autoincrement())
  provider     String
  metric       String
  source       String?
  requestedFrom DateTime               @db.Date
  requestedTo   DateTime               @db.Date
  receivedFrom  DateTime?              @db.Date
  receivedTo    DateTime?              @db.Date
  rowCount      Int?
  contentHash   String?
  status        XmIngestionWindowStatus
  fetchedAt     DateTime?              @db.Timestamptz(3)
  errorCode     String?
  energyDatasetId Int?                 @unique
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)
  energyDataset EnergyDataset?         @relation(fields: [energyDatasetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, metric, requestedFrom, requestedTo])
  @@index([metric, status])
}

model PreparedDataset {
  id                   Int                      @id @default(autoincrement())
  sourceDatasetId      Int
  profileId            String
  profileVersion       String
  preparedAt           DateTime                 @default(now()) @db.Timestamptz(3)
  sourceRulesetId      String
  sourceRulesetVersion String
  content              Json
  transformations      Json
  sourceDataset        EnergyDataset            @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  priceExecutions      PriceForecastExecution[]
  patternAnalyses      PatternAnalysis[]

  @@unique([sourceDatasetId, profileId, profileVersion])
}

enum PatternAnalysisStatus {
  completed
  partial
  no_results
  failed
}

enum AiQueryExecutionStatus {
  succeeded
  empty
  failed
}

enum AiQueryRequesterType {
  authenticated_user
  system
}

model AiQueryTrace {
  id              String                 @id @default(uuid()) @db.Uuid
  requestId       String                 @db.Uuid
  startedAt       DateTime               @db.Timestamptz(3)
  completedAt     DateTime               @db.Timestamptz(3)
  durationMs      Int
  requesterType   AiQueryRequesterType
  requesterId     String?                @db.Uuid
  httpMethod      String
  endpoint        String
  capability      String
  parametersSnapshot Json
  modelId         String?
  modelVersion    String?
  methodId        String?
  methodVersion   String?
  executionStatus AiQueryExecutionStatus
  resultStatus    String?
  errorCode       String?
  resourceType    String?
  resourceId      String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)

  @@index([requestId])
  @@index([createdAt])
  @@index([endpoint])
}

model PatternAnalysis {
  id                String                @id @db.Uuid
  preparedDatasetId Int
  status            PatternAnalysisStatus
  dataType          EnergyDatasetType
  variable          String
  periodStart       DateTime?             @db.Date
  periodEnd         DateTime?             @db.Date
  methodId          String
  methodVersion     String
  sampleSize        Int
  resultSnapshot    Json
  warnings          Json
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  preparedDataset   PreparedDataset       @relation(fields: [preparedDatasetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([preparedDatasetId])
  @@index([createdAt])
  @@index([dataType, variable])
  @@index([periodStart, periodEnd])
}

enum PriceForecastExecutionStatus {
  pending
  succeeded
  failed
}

enum PriceForecastConditionsCompleteness {
  complete
  partial
}

enum MatchingExecutionStatus {
  pending
  succeeded
  failed
}

enum MatchingResultStatus {
  matched
  partial
  no_matches
}

model PriceForecastExecution {
  id                     String                               @id @default(uuid()) @db.Uuid
  forecastType           String
  targetDate             DateTime?                            @db.Date
  preparedDatasetId      Int?
  ruleId                 String?
  ruleVersion            String?
  ruleType               String?
  requestPayload         Json
  inputSnapshot          Json?
  resultPayload          Json?
  status                 PriceForecastExecutionStatus         @default(pending)
  conditionsCompleteness PriceForecastConditionsCompleteness?
  partialReasons         Json?
  httpStatus             Int?
  errorCode              String?
  createdAt              DateTime                             @default(now()) @db.Timestamptz(3)
  completedAt            DateTime?                            @db.Timestamptz(3)
  preparedDataset        PreparedDataset?                     @relation(fields: [preparedDatasetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([targetDate])
  @@index([preparedDatasetId])
}

model MatchingExecution {
  id               String                 @id @db.Uuid
  executionStatus  MatchingExecutionStatus @default(pending)
  matchingStatus   MatchingResultStatus?
  criteriaVersion  String
  criteriaSnapshot Json
  inputSnapshot    Json?
  resultSnapshot   Json?
  errorCode        String?
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?              @db.Timestamptz(3)

  @@index([createdAt])
  @@index([executionStatus])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions AuthSession[]
  offers EnergyOffer[]
  demands EnergyDemand[]
}
model AuthSession {
  tokenHash String @id @db.Char(64)
  userId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

enum EnergyMarketStatus {
  ACTIVE
}

model EnergyOffer {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  quantityKwh  Decimal           @db.Decimal(20, 2)
  pricePerKwh  Decimal           @db.Decimal(18, 5)
  deliveryDate DateTime          @db.Date
  status       EnergyMarketStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([status])
  @@index([deliveryDate])
}

model EnergyDemand {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  quantityKwh    Decimal           @db.Decimal(20, 2)
  maxPricePerKwh Decimal           @db.Decimal(18, 5)
  deliveryDate   DateTime          @db.Date
  status         EnergyMarketStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([status])
  @@index([deliveryDate])
}
