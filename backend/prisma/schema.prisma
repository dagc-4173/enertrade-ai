// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnergyDatasetType {
  generacion
  consumo
  oferta
  demanda
  precios
  transacciones_simuladas
}

enum EnergyDatasetStatus {
  recibido
  aprobado
  advertencia
  rechazado
}

model EnergyDataset {
  id                    Int                 @id @default(autoincrement())
  source                String
  dataType              EnergyDatasetType
  uploadedAt            DateTime            @default(now()) @db.Timestamptz(3)
  status                EnergyDatasetStatus @default(recibido)
  content               Json
  pendingOptionalFields Json
  validatedAt           DateTime?           @db.Timestamptz(3)
  validationReport      Json?
  preparedDatasets      PreparedDataset[]
}

model PreparedDataset {
  id                   Int           @id @default(autoincrement())
  sourceDatasetId      Int
  profileId            String
  profileVersion       String
  preparedAt           DateTime      @default(now()) @db.Timestamptz(3)
  sourceRulesetId      String
  sourceRulesetVersion String
  content              Json
  transformations      Json
  sourceDataset        EnergyDataset @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sourceDatasetId, profileId, profileVersion])
}
